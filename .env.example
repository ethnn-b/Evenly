# Supabase project settings. Copy this file to .env.local and fill in real values.
# Find these under Project Settings -> API in the Supabase dashboard.

# The project URL, looks like https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The anon/public key. Safe to expose in the browser because RLS guards the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Groq API key for LLM expense-name/category suggestions from receipt text.
# Server-side only (never shipped to the browser). Get one at https://console.groq.com/keys.
# Leave blank to disable: the app falls back to the local heuristic name.
GROQ_API_KEY=

# Optional model override. Defaults to llama-3.3-70b-versatile.
GROQ_MODEL=
